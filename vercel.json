{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/submit", "destination": "/api/submit" }
  ],
  "redirects": [
    { "source": "/yt", "destination": "/?utm_source=youtube&utm_medium=social&utm_campaign=channel_profile", "permanent": false },
    { "source": "/ig", "destination": "/?utm_source=instagram&utm_medium=social&utm_campaign=profile_bio", "permanent": false },
    { "source": "/kt", "destination": "/?utm_source=kakao&utm_medium=social&utm_campaign=openchat_profile", "permanent": false },
    { "source": "/fm", "destination": "/?utm_source=fmkorea&utm_medium=referral&utm_campaign=community_post", "permanent": false }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
